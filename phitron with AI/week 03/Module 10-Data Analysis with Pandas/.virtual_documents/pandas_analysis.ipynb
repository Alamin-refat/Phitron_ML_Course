# 4 problem solved

import pandas as pd

data = {
    'Product': ['Pen', 'Book', 'Eraser', 'Pencil'],
    'Price': [10, 50, 5, 7],
    'Quantity': [100, 60, 200, 150]
}

df = pd.DataFrame(data)
# First Row
print("First Row (iloc):")
print(df.iloc[0])

print("\nFirst Row (loc):")
print(df.loc[0])

# Second Column
print("\nSecond Column (iloc):")
print(df.iloc[:, 1])

print("\nSecond Column (loc):")
print(df.loc[:, 'Price'])

# 2x2 Middle Block
print("\n2x2 Block (iloc):")
print(df.iloc[1:3, 1:3])

print("\n2x2 Block (loc):")
print(df.loc[1:2, ['Price', 'Quantity']])


# problem 5 solved
import pandas as pd

# Create DataFrame
data = {
    'Name': ['Alamin', 'Rahim', 'Karim', 'Sakib'],
    'Math': [85, 90, 78, 92],
    'Science': [88, 76, 80, 95]
}

df = pd.DataFrame(data)

print("Original DataFrame:")
print(df)

# Drop one column
df_column_drop = df.drop('Science', axis=1)

print("\nAfter Dropping Column:")
print(df_column_drop)

# Drop one row
df_row_drop = df.drop(2)

print("\nAfter Dropping Row:")
print(df_row_drop)


# problem 6 solved
import pandas as pd

# Create DataFrame
data = {
    'Name': ['Alamin', 'Rahim', 'Karim', 'Sakib'],
    'Department': ['IT', 'HR', 'Finance', 'Marketing'],
    'Salary': [50000, 45000, 60000, 55000]
}

df = pd.DataFrame(data)

print("Original DataFrame:")
print(df)

# Sort by Salary (Ascending)
salary_sort = df.sort_values(by='Salary')

print("\nSorted by Salary (Ascending):")
print(salary_sort)

# Sort by Name (Descending)
name_sort = df.sort_values(by='Name', ascending=False)

print("\nSorted by Name (Descending):")
print(name_sort)


# problem 7 solved
import pandas as pd

# Create DataFrame
data = {
    'Name': ['Alamin', 'Rahim', 'Karim', 'Sakib', 'Nayeem', 'Rafi', 'Jahid', 'Tanvir'],
    'Score': [85, 35, 72, 28, 90, 55, 38, 67]
}

df = pd.DataFrame(data)

print("Original DataFrame:")
print(df)

# Students with Score > 60
high_score = df[df['Score'] > 60]

print("\nStudents with Score > 60:")
print(high_score)

# Students with Score < 40
low_score = df[df['Score'] < 40]

print("\nStudents with Score < 40:")
print(low_score)




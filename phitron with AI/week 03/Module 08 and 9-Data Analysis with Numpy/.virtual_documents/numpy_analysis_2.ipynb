# faster for vectorization

x = np.array([10,20,30,40])
y = np.array([2,3,4,5])

add=np.add(x,y)
print(add)

sub=x-y
print(sub)

mul=x*y
print(mul)

div=x/y
print(div)

reminder=x%y
print(reminder)


# mathmatical function

# trigronometri funtion
# sin,cos tan takes value radian

sin_val=np.sin(x)
print(sin_val)

deg_con=np.rad2deg(x)
print(deg_con)





# comparison operator - .>, >, >=, =<, ==, !=

x = np.array([10,20,30,40])
y = np.array([2,3,30,5])

greater = x>y
print(greater)
equal = x==y
print(equal)

# all() -> shob true kina
# any() -> jekono ekta true kina

print(np.all(greater))
print(np.any(equal))






